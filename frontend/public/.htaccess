# ---------------------------------------------------------------------------
# La pagina compilada (dist/sitio/browser). Este archivo viaja con el build:
# es una de las dos puertas que el .htaccess de la raiz abre a proposito.
# ---------------------------------------------------------------------------
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
Options -Indexes

# Rutas de Angular: todo lo que no es un archivo va a index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Scripts propios; estilos propios y Google Fonts (Angular inyecta estilos
  # en linea, de ahi 'unsafe-inline'). El mapa de Google se agrega en la
  # fase 2 (frame-src) si se usa incrustado.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Las fotos, los logos y los paquetes con hash se guardan un año;
  # index.html y contenido.json nunca, para que un cambio se vea de una vez.
  <FilesMatch "\.(webp|jpg|png|svg|woff2|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(index\.html|contenido\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
